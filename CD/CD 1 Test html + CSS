<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crescentia Digital</title>
    <style>
        /* General Styles */
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            text-align: center;
            background-color: #f4f4f4;
            color: #333;
        }

        /* Header */
        header {
            background-color: #2c3e50;
            color: white;
            padding: 20px;
            font-size: 28px;
            font-weight: bold;
        }

        /* Section Styling */
        section {
            margin: 20px auto;
            padding: 20px;
            background: white;
            border-radius: 10px;
            width: 80%;
            max-width: 800px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
        }

        h1, h2 {
            color: #2c3e50;
        }

        p {
            font-size: 18px;
            line-height: 1.6;
        }

        /* Services List */
        ul {
            list-style: none;
            padding: 0;
        }
        ul li {
            background: #1abc9c;
            color: white;
            padding: 10px;
            margin: 5px;
            border-radius: 5px;
            font-size: 16px;
        }

        /* Contact Section */
        .contact {
            font-size: 18px;
            color: #555;
        }

        /* Footer */
        footer {
            background-color: #2c3e50;
            color: white;
            padding: 10px;
            position: fixed;
            width: 100%;
            bottom: 0;
        }
    </style>
</head>
<body>

    <header>
        🌙 Crescentia Digital
    </header>

    <section>
        <h1>Welcome to Crescentia Digital</h1>
        <p>Empowering businesses with cutting-edge digital solutions, including AI-driven marketing, website development, SEO, and automation.</p>
    </section>

    <section>
        <h2>🌟 Our Services</h2>
        <ul>
            <li>🌍 Website Development</li>
            <li>🤖 AI-Driven Marketing</li>
            <li>📈 SEO Optimization</li>
            <li>🎨 Branding & Logo Design</li>
            <li>⚙️ Automation & AI Chatbots</li>
        </ul>
    </section>

    <section>
        <h2>📞 Contact Us</h2>
        <p class="contact">📧 Email: contact@crescentiadigital.com</p>
        <p class="contact">📞 Phone: +1 234 567 890</p>
    </section>

    <footer>
        © 2024 Crescentia Digital | All Rights Reserved
    </footer>

</body>
</html>
